{
  "name": "insights",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main-electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c blue,magenta \"npm run dev\" \"wait-on http://localhost:4987 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.0.5",
    "@reduxjs/toolkit": "^2.0.0",
    "@types/lodash": "^4.17.0",
    "@types/luxon": "^3.4.0",
    "ag-grid-community": "^31.2.0",
    "ag-grid-react": "^31.2.0",
    "d3": "^7.9.0",
    "embla-carousel-react": "^8.0.0",
    "html-react-parser": "^5.1.12",
    "lodash": "^4.17.21",
    "lodash.isequal": "^4.5.0",
    "luxon": "^3.5.0",
    "material-icons": "^1.13.8",
    "material-symbols": "^0.22.0",
    "plotly.js": "^2.35.0",
    "plotly.js-dist-min": "^2.35.0",
    "postcss-nesting": "^13.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-loading-skeleton": "^3.5.0",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.30.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "@types/d3": "^7.4.0",
    "@types/lodash.isequal": "^4.5.6",
    "@types/node": "^24.0.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.0",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "daisyui": "^4.12.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
