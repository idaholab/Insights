{
  "name": "insights-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --legacy-watch src/index.ts",
    "build": "npm run build:compile && npm run build:copy_files",
    "build:compile": "esbuild src/index.ts --platform=node --bundle --outfile=build/app.js",
    "build:copy_files": "npx -y cpy-cli node_modules/better-sqlite3/build/Release/better_sqlite3.node build/ --flat && npx -y cpy-cli db/insights/insights.db build/ --flat && npx -y cpy-cli store/ build/store/",
    "start": "NODE_PATH=./build node build/app.js"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.13",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.4",
    "nodemon": "^3.1.7",
    "ts-node": "^10.2.0",
    "tsx": "^4.19.1",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.17.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  }
}
