# Insights API config for the bundled (Electron) deployment.
# Paths are relative to resources/api/ where app.js runs.

# Server
ADAPTER_NAME=insights-api
ADAPTER_URL=http://localhost
ADAPTER_PORT=8181

# Data source
DATA_SOURCE=sqlite

# DB sits right next to app.js (build:api:copy_files copies it flat into build/local/)
DB_PATH=insights.db

# Local JSON store base URL — required when DATA_SOURCE=local
LOCAL_STORE_BASE_URL=http://localhost:8181/store

# JSON file names (only used when DATA_SOURCE=local)
ALL_ATTACKS_METRICS=all_attacks_metrics.json
ALL_ATTACKS_BAM=all_attacks_bam.json
ATTACK_MATRIX_MAPPING=attack_matrix_mapping.json
ATTACK_MATRIX_TECHNIQUES=attack_matrix_techniques.json
ATTACK_MATRIX_CATEGORIES=attack_matrix_categories.json
FINANCIAL_LOSS_HISTOGRAM=financial_loss_histogram.json
PAR_LOSSES=par_losses.json
RANSOMWARE_PARS=ransomware_pars.json
REPORT_MAIN=report_main.json
REPORT_TECHNIQUES=report_techniques.json
REPORT_TECHNIQUES_TIMING=report_techniques_timing.json
TACTIC_TECHNIQUE_OBSERVABLE_COUNTS=tactic_technique_observable_counts.json
TACTIC_TECHNIQUE_PAR_COUNTS=tactic_technique_par_counts.json
TOP_5_IMPACT_COUNTS=top_5_impact_counts.json
OBSERVABLES=all_case_study_observables.json
WORD_CLOUD_DYN_TOPIC=jupyter_wc_dynamic_topic_model.json
WORD_CLOUD_INTER_DIST=jupyter_wc_intertopic_dist_map.json
WORD_CLOUD_HIER_CLUST=jupyter_wc_topic_hierarchical_clustering.json
WORD_CLOUD_SIM_MATRIX=jupyter_wc_topic_similarity_matrix.json
WORD_CLOUD_WORD_SCORES=jupyter_wc_topic_word_scores.json
